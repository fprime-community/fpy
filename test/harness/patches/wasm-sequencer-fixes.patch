 // \brief  cpp file for WasmSequencer Wasm Host functions
 // ======================================================================
 
+#include <cmath>
 #include <limits>
 
 #include "Fw/Types/Assert.hpp"
@@ -36,6 +37,52 @@ static spacewasm_hostcall_result_t hostFunctionTrampoline(struct spacewasm_calle
     return (static_cast<WasmSequencer*>(userdata)->*Handler)(caller, params, n_params, out_result);
 }
 
+void WasmSequencer ::hostEnv(spacewasm_host_t* host) {
+    // The float library calls LLVM materializes for guest float arithmetic
+    // (llvm.pow, frem, llvm.log). wasm-ld leaves them under wasm's default
+    // import module "env". They are pure math, so they answer synchronously.
+    spacewasm_status_t status;
+    U32 module_idx;
+    status = spacewasm_add_host_module(host, "env", 3, 0, &module_idx);
+    FW_ASSERT(status == SPACEWASM_OK, status);
+
+    status = spacewasm_add_host_function(
+        host, module_idx, "pow", "dd", "d",
+        [](spacewasm_caller_t*, void*, const spacewasm_value_t* params, size_t n_params, spacewasm_value_t* out) {
+            FW_ASSERT(params != nullptr);
+            FW_ASSERT(n_params == 2, static_cast<FwAssertArgType>(n_params));
+            out->tag = SPACEWASM_F64;
+            out->u.f64_ = std::pow(params[0].u.f64_, params[1].u.f64_);
+            return SPACEWASM_CONTINUE_SOME;
+        },
+        nullptr);
+    FW_ASSERT(status == SPACEWASM_OK, status);
+
+    status = spacewasm_add_host_function(
+        host, module_idx, "fmod", "dd", "d",
+        [](spacewasm_caller_t*, void*, const spacewasm_value_t* params, size_t n_params, spacewasm_value_t* out) {
+            FW_ASSERT(params != nullptr);
+            FW_ASSERT(n_params == 2, static_cast<FwAssertArgType>(n_params));
+            out->tag = SPACEWASM_F64;
+            out->u.f64_ = std::fmod(params[0].u.f64_, params[1].u.f64_);
+            return SPACEWASM_CONTINUE_SOME;
+        },
+        nullptr);
+    FW_ASSERT(status == SPACEWASM_OK, status);
+
+    status = spacewasm_add_host_function(
+        host, module_idx, "log", "d", "d",
+        [](spacewasm_caller_t*, void*, const spacewasm_value_t* params, size_t n_params, spacewasm_value_t* out) {
+            FW_ASSERT(params != nullptr);
+            FW_ASSERT(n_params == 1, static_cast<FwAssertArgType>(n_params));
+            out->tag = SPACEWASM_F64;
+            out->u.f64_ = std::log(params[0].u.f64_);
+            return SPACEWASM_CONTINUE_SOME;
+        },
+        nullptr);
+    FW_ASSERT(status == SPACEWASM_OK, status);
+}
